---
/* Site-wide search dialog. Opens from the nav button, Ctrl/Cmd+K or "/",
   and from any element dispatching `pesos:search` (e.g. the error page's
   search box). The index (/search.json) is fetched on first open. */
---
<dialog class="search-dlg" data-search aria-label="Search the site">
  <div class="search-dlg__bar">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
    <input class="search-dlg__input" type="search" placeholder="Search pages, projects, posts…" aria-label="Search" autocomplete="off" data-search-input />
    <button class="search-dlg__esc" type="button" data-search-close>Esc</button>
  </div>
  <ul class="search-dlg__results" data-search-results></ul>
</dialog>

<script>
  type Entry = { t: string; d: string; s: string; u: string; x?: 1 };

  const dlg = document.querySelector<HTMLDialogElement>('[data-search]');
  if (dlg) {
    const input = dlg.querySelector<HTMLInputElement>('[data-search-input]')!;
    const list = dlg.querySelector<HTMLUListElement>('[data-search-results]')!;
    let index: Entry[] | null = null;
    let focused = -1;

    const load = async () => {
      if (index) return index;
      try {
        index = (await (await fetch('/search.json')).json()) as Entry[];
      } catch {
        index = [];
      }
      return index;
    };

    const esc = (s: string) =>
      s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);

    // every word must appear somewhere; title hits rank above description hits
    const score = (e: Entry, words: string[]) => {
      const t = e.t.toLowerCase();
      const all = `${t} ${e.d.toLowerCase()} ${e.s.toLowerCase()}`;
      let n = 0;
      for (const w of words) {
        if (!all.includes(w)) return -1;
        n += t.startsWith(w) ? 4 : t.includes(w) ? 2 : 1;
      }
      return n;
    };

    const render = async () => {
      const q = input.value.trim().toLowerCase();
      const words = q.split(/\s+/).filter(Boolean);
      const idx = await load();
      const hits = words.length
        ? idx
            .map((e) => ({ e, n: score(e, words) }))
            .filter((h) => h.n >= 0)
            .sort((a, b) => b.n - a.n)
            .slice(0, 12)
            .map((h) => h.e)
        : idx.filter((e) => !e.x && e.u.endsWith('/') && e.d && !e.u.includes('/projects/') ).slice(0, 12);
      focused = -1;
      list.innerHTML = hits.length
        ? hits
            .map(
              (e) => `<li><a href="${esc(e.u)}"${e.x ? ' target="_blank" rel="noopener"' : ''}>
                <span class="search-dlg__t"><span class="search-dlg__sec">${esc(e.s)}</span>${esc(e.t)}${e.x ? ' ↗' : ''}</span>
                <span class="search-dlg__meta">${esc(e.d.length > 110 ? e.d.slice(0, 110) + '…' : e.d)}</span>
              </a></li>`
            )
            .join('')
        : `<li class="search-dlg__empty">No results for “${esc(input.value.trim())}”.</li>`;
    };

    const open = (q = '') => {
      if (!dlg.open) dlg.showModal();
      input.value = q;
      input.focus();
      render();
    };

    const move = (dir: number) => {
      const links = Array.from(list.querySelectorAll<HTMLAnchorElement>('a'));
      if (!links.length) return;
      focused = (focused + dir + links.length) % links.length;
      links.forEach((a, i) => a.classList.toggle('is-focused', i === focused));
      links[focused].scrollIntoView({ block: 'nearest' });
    };

    input.addEventListener('input', render);
    input.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') { e.preventDefault(); move(1); }
      else if (e.key === 'ArrowUp') { e.preventDefault(); move(-1); }
      else if (e.key === 'Enter') {
        const links = list.querySelectorAll<HTMLAnchorElement>('a');
        const target = links[focused >= 0 ? focused : 0];
        if (target) { e.preventDefault(); target.click(); }
      }
    });
    dlg.querySelector('[data-search-close]')?.addEventListener('click', () => dlg.close());
    // click on the backdrop closes
    dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });

    document.querySelectorAll('[data-search-open]').forEach((b) =>
      b.addEventListener('click', () => open())
    );
    window.addEventListener('pesos:search', (e) => open((e as CustomEvent<string>).detail ?? ''));
    document.addEventListener('keydown', (e) => {
      const typing = (e.target as HTMLElement)?.closest('input, textarea, select, [contenteditable]');
      if ((e.key === 'k' && (e.metaKey || e.ctrlKey)) || (e.key === '/' && !typing)) {
        e.preventDefault();
        open();
      }
    });
  }
</script>
