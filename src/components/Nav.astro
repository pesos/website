---
import { SITE, NAV } from '../data/site';
import Wordmark from './Wordmark.astro';
---

<header class="nav">
  <div class="wrap nav__inner">
    <a href="/" class="brand" aria-label={SITE.name + ' home'}>
      <Wordmark />
    </a>

    <nav class="nav__links" aria-label="Primary">
      {NAV.map((s) => (
        <div class:list={['nav__item', s.children.length > 0 && 'has-menu']}>
          <a class="nav__link" href={s.href} data-base={s.base}>{s.label}</a>
          {s.children.length > 0 && (
            <div class="nav__menu">
              {s.children.map((c) => <a href={c.href}>{c.label}</a>)}
            </div>
          )}
        </div>
      ))}
    </nav>

    <div class="nav__right">
      <button class="icon-btn" data-search-open type="button" aria-label="Search the site (Ctrl+K)">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      </button>

      <button class="icon-btn" data-theme-toggle type="button" aria-label="Toggle theme">
        <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"/></svg>
        <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      </button>

      <button type="button" class="term-btn" title="Open terminal" aria-label="Open terminal">
        <span aria-hidden="true">&gt;_</span><span class="term-btn__label">Terminal</span>
      </button>

      <button class="nav__toggle" data-nav-toggle type="button" aria-label="Menu" aria-expanded="false">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
      </button>
    </div>
  </div>

  <div class="nav__drawer" data-nav-drawer>
    {NAV.map((s) =>
      s.children.length > 0 ? (
        <div class="nav__drawer-group">
          <span class="nav__drawer-head">{s.label}</span>
          {s.children.map((c) => <a href={c.href}>{c.label}</a>)}
        </div>
      ) : (
        <a href={s.href}>{s.label}</a>
      )
    )}
    <button type="button" class="term-btn" title="Open terminal" aria-label="Open terminal from menu">
      <span aria-hidden="true">&gt;_</span><span class="term-btn__label">Terminal</span>
    </button>
  </div>
</header>
