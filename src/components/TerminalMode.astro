      el.addEventListener('pointerdown', (e) => {
        this.drag = true;
        try { el.setPointerCapture(e.pointerId); } catch (err) {}
        jump(e);
      });
      el.addEventListener('pointermove', (e) => { if (this.drag) jump(e); });
      el.addEventListener('pointerup', () => { this.drag = false; });
      el.addEventListener('pointercancel', () => { this.drag = false; });
    }
    sync() {
      const sc = this.getScroller();
      const hide = () => { this.el.style.opacity = '0'; this.el.style.pointerEvents = 'none'; };
      if (!sc) return hide();
      const max = sc.scrollHeight - sc.clientHeight;
      if (max <= 8) return hide();
      this.el.style.opacity = '1';
      this.el.style.pointerEvents = 'auto';
      const p = Math.min(1, Math.max(0, sc.scrollTop / max));
      const h = this.el.clientHeight;
      const catH = this.cat.offsetHeight;
      const y = p * (h - catH);
      this.cat.style.transform = 'translateY(' + y.toFixed(1) + 'px)';
      this.rain.style.height = (y + catH * 0.27).toFixed(1) + 'px';
    }
  }

