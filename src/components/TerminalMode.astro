---
// Developer Mode: the whole site, browsable as markdown inside a terminal.
//
// Self-contained: the main website knows nothing about it. BaseLayout.astro
// only imports it and renders <TerminalMode /> as the first thing in <body>;
// delete those two lines (and this file, src/lib/terminalContent.ts,
// src/pages/terminal-content.json.ts, the turndown dependency) and the
// website is exactly as it was. Everything else hooks in from the outside:
//  - html.mode-dev    -> the website (every other child of <body>) fades out
//                        and is made inert; this fills the screen
//  - html.mode-normal -> this fades out, the normal website shows
// The normal website loads first. Backtick toggles (Ctrl+T too, where the
// browser lets it through); the choice is kept per session. The nav's existing ">_ Terminal" links (found
// by .term-btn / their text, the nav itself is untouched) open it too.
//
// The terminal keeps the address bar on the website route of whatever it is
// showing, so switching back lands on the matching page, and loading any
// route in dev mode opens its terminal equivalent.
//
// Reading a file (`cat`) opens a man/less-style pager: top of file, arrow
// keys / j k / space / g G to move, q to quit. Content comes from
// /terminal-content.json (see src/lib/terminalContent.ts). Colours: the website's own palette,
// dark or light to match the site's theme.
---

<!-- pick the mode before the website paints (this is the first thing in <body>).
     The website is the default; the terminal only opens once the visitor
     chooses it (>_ Terminal, backtick), and then stays on for the session. -->
<script is:inline>
  (function () {
    var dev = false;
    try {
      dev = sessionStorage.getItem('pesosMode') === 'dev';
    } catch (e) {}
    document.documentElement.classList.add(dev ? 'mode-dev' : 'mode-normal');
    if (dev) {
      document.addEventListener('DOMContentLoaded', function () {
        document.querySelectorAll('body > :not(#pesos-terminal):not(script)').forEach(function (el) {
          el.inert = true;
        });
      });
    }
  })();
</script>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css?family=Source+Code+Pro:400,700&display=swap" rel="stylesheet" />

<div id="pesos-terminal" aria-hidden="true">
  <canvas class="pt-matrix"></canvas>

  <div class="pt-window">
    <div class="pt-scrollback" role="log" aria-live="polite"></div>
    <div class="pt-input-line">
      <span class="pt-prompt"></span>
      <span class="pt-typed"></span>
      <span class="pt-cursor"></span>
      <input
        class="pt-input"
        type="text"
        autocomplete="off"
        autocapitalize="off"
        spellcheck="false"
        aria-label="terminal input"
      />
    </div>
  </div>

  <div class="pt-pager" hidden>
    <div class="pt-pager-body"></div>
    <div class="pt-pager-status"></div>
  </div>

  <div class="pt-nyan" aria-hidden="true">
    <div class="pt-nyan-rain"></div>
    <div class="pt-nyan-cat">
