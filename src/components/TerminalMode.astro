        }
        // files and folders aren't clickable: you `cd` / `cat` them, as in
        // a real terminal. External URLs still open in a new tab.
        const t = e.target.closest('[data-href],[data-mode]');
        if (!t) { if (!this.paging) this.focus(); return; }
        if (t.dataset.mode) { this.pickMode(t.dataset.mode); return; }
        window.open(t.dataset.href, '_blank', 'noopener');
      };
      this.win.addEventListener('click', onClick);
      this.pagerBody.addEventListener('click', onClick);
      this.pagerStatus.addEventListener('click', () => this.closePager());
      this.win.addEventListener('scroll', () => this.nyan.sync(), { passive: true });
      this.pagerBody.addEventListener('scroll', () => {
        this.nyan.sync();
        this.updatePagerStatus();
      }, { passive: true });
      window.addEventListener('resize', () => { this.nyan.sync(); this.updatePagerStatus(); });
      // the rain starts right away; the content downloads underneath it. The
      // prompt (and its blinking cursor) stays hidden until the rain is gone.
      const raining = (boot || rainFirst) && !reducedMotion();
      if (raining) this.root.classList.add('pt-raining');
      const rain = raining ? this.matrix() : null;
      await this.loadManifest();
      if (boot) {
        await this.runBoot(rain);
      } else {
        if (rain) await rain;
        this.root.classList.remove('pt-raining');
        this.setPrompt();
        this.openForLocation();
        this.enableSmooth();
      }
      this.focus();
    }

    async loadManifest() {
      try {
        const res = await fetch(BASE + '/terminal-content.json', { cache: 'no-cache' });
        const data = await res.json();
        this.entries = data.entries || {};
        this.dirs = data.dirs || {};
        this.meta = data.meta || {};
        SITEMAP = data.siteMap || {};
      } catch (e) {
        this.entries = {}; this.dirs = {}; this.meta = {};
      }
      this.paths = Object.keys(this.entries).sort();
      ENTRYSET = new Set(this.paths.concat(Object.keys(this.dirs)));
      this.dirIndex = {};
      Object.keys(this.dirs).forEach((k, i) => { this.dirIndex[k] = i; });
    }

    enableSmooth() {
      this.win.classList.add('pt-smooth');
      this.pagerBody.classList.add('pt-smooth');
    }

    bindInput() {
      this.input.addEventListener('input', () => {
        this.typed.textContent = this.input.value;
      });
      this.input.addEventListener('keydown', (e) => {
        if (this.booting || this.animating || this.paging) { e.preventDefault(); return; }
        if (e.key === 'Enter') {
          const v = this.input.value;
          this.input.value = '';
          this.typed.textContent = '';
          this.run(v);
        } else if (e.key === 'ArrowUp') {
          e.preventDefault();
          if (this.histIdx > 0) {
            this.histIdx--;
            this.input.value = this.history[this.histIdx] || '';
            this.typed.textContent = this.input.value;
          }
        } else if (e.key === 'ArrowDown') {
          e.preventDefault();
          if (this.histIdx < this.history.length) {
            this.histIdx++;
            this.input.value = this.history[this.histIdx] || '';
            this.typed.textContent = this.input.value;
          }
        } else if (e.key === 'c' && e.ctrlKey && this.asking) {
          e.preventDefault();
          this.input.value = '';
          this.typed.textContent = '';
          this.cancelAsk();
        } else if (e.key === 'l' && e.ctrlKey) {
          e.preventDefault();
          this.clear();
        } else if (e.key === 'Tab') {
          e.preventDefault();
          this.complete();
        }
      });
    }

    complete() {
      const val = this.input.value;
      const secondTab = this.lastTabVal === val;
      this.lastTabVal = val;
      const CMDS = ['ls', 'cd', 'cat', 'less', 'man', 'tree', 'grep', 'search',
        'neofetch', 'pwd', 'clear', 'whoami', 'date', 'help', 'mode', 'send', 'exit'];
      let candidates, prefix, head, isPath;
      if (!val.includes(' ')) {
        isPath = false;
        prefix = val.trim();
        head = '';
        candidates = CMDS.filter((c) => c.startsWith(prefix));
      } else {
        isPath = true;
        const sp = val.lastIndexOf(' ');
        head = val.slice(0, sp + 1);
        const frag = val.slice(sp + 1);
        const slash = frag.lastIndexOf('/');
        const dirPart = slash >= 0 ? frag.slice(0, slash + 1) : '';
        const seg = slash >= 0 ? frag.slice(slash + 1) : frag;
        const baseDir = resolvePath(this.cwd, dirPart || '.');
        candidates = this.childrenOf(baseDir)
          .filter((k) => k.seg.startsWith(seg))
          .map((k) => dirPart + k.seg + (k.isDir ? '/' : ''));
        prefix = dirPart + seg;
      }
      if (!candidates.length) return;
      if (candidates.length === 1) {
        this.input.value = head + candidates[0] + (isPath ? '' : ' ');
        this.lastTabVal = this.input.value;
      } else {
        const lcp = candidates.reduce((a, b) => {
          let i = 0;
          while (i < a.length && a[i] === b[i]) i++;
          return a.slice(0, i);
        });
        if (lcp.length > prefix.length) {
          this.input.value = head + lcp;
          this.lastTabVal = this.input.value;
        } else if (secondTab) {
          this.print(candidates.map((c) => '<span class="pt-file">' + esc(c) + '</span>').join('   '));
        }
      }
      this.typed.textContent = this.input.value;
    }

    focus() {
      if (this.paging) { try { this.pagerBody.focus({ preventScroll: true }); } catch (e) {} return; }
      if (document.documentElement.classList.contains('mode-dev')) {
        try { this.input.focus({ preventScroll: true }); } catch (e) { this.input.focus(); }
      }
    }

    setPrompt(mode) {
      if (mode) {
        this.promptPlain = mode + '>';
        this.promptEl.innerHTML =
          '<span class="pt-seg pt-seg-mode">' + esc(mode) + '</span>' +
          '<span class="pt-seg-caret">❯</span>';
        return;
      }
      const path = this.cwd === '/' ? '~' : '~' + this.cwd;
      this.promptPlain = 'guest@pesos:' + this.cwd + '$';
      this.promptEl.innerHTML =
        '<span class="pt-seg pt-seg-user">guest</span>' +
        '<span class="pt-seg pt-seg-branch">main</span>' +
        '<span class="pt-seg pt-seg-path">' + esc(path) + '</span>' +
        '<span class="pt-seg-caret">❯</span>';
    }

    /* ---- output ------------------------------------------------------- */
    print(html, cls) {
      const div = document.createElement('div');
      div.className = 'pt-line' + (cls ? ' ' + cls : '');
      div.innerHTML = html;
      if (this.reveal != null && !reducedMotion()) {
        // fade in one after another; long pages stop staggering after a few
        div.classList.add('pt-enter');
        div.style.animationDelay = Math.min(this.reveal++, 14) * 60 + 'ms';
      }
      this.scrollback.appendChild(div);
      this.scrollBottom();
      return div;
    }
    println(text, cls, path) {
      const div = this.print(esc(text), cls);
      if (path) div.dataset.path = path;
      return div;
    }
    echo(line) {
      this.print(
        '<span class="pt-prompt-echo">' + esc(this.promptPlain) + '</span> ' + esc(line),
        'pt-echo'
      );
    }
    clear() { this.scrollback.innerHTML = ''; }
    // fade the screen out, clear it, then run `then` (which paints the next one)
    fadeOut(then) {
      if (reducedMotion()) { this.clear(); return then(); }
      this.scrollback.classList.add('pt-fading');
      setTimeout(() => {
        this.clear();
        this.scrollback.classList.remove('pt-fading');
        then();
      }, 220);
    }
    scrollBottom() {
      const w = this.win;
      if (!w) return;
      if (this.booting) w.scrollTop = w.scrollHeight;
      else {
        try { w.scrollTo({ top: w.scrollHeight, behavior: 'smooth' }); }
        catch (e) { w.scrollTop = w.scrollHeight; }
      }
      if (this.nyan) this.nyan.sync();
    }
    sleep(ms) { return new Promise((r) => setTimeout(r, ms)); }

    /* ---- command loop ----------------------------------------------- */
    run(raw) {
      const line = raw.trim();
      this.echo(raw);
      if (this.asking) return this.answer(line);
      if (!line) return;
      if (this.history[this.history.length - 1] !== line) this.history.push(line);
      this.histIdx = this.history.length;
      if (this.awaitingMode) return this.pickMode(line);
      this.exec(line);
    }

    exec(line) {
      if (DESTRUCTIVE.some((d) => line.replace(/\s+/g, ' ').includes(d))) return this.fire();
      // "/text" is a shortcut for search, unless it names a real path
      if (line[0] === '/' && line.length > 1) {
        const asPath = resolvePath(this.cwd, line.trim());
        if (!this.entries[asPath] && !this.childrenOf(asPath).length) return this.grep(line.slice(1));
      }
      const parts = line.trim().split(/\s+/);
      const cmd = (parts.shift() || '').toLowerCase();
      const arg = parts[0];
      switch (cmd) {
        case 'help': case '?': return this.help();
        case 'ls': case 'dir': return this.ls(arg);
        case 'tree': return this.tree('/', '');
        case 'cd': return this.cd(arg);
        case 'cat': case 'open': case 'less': case 'more':
        case 'man': case 'view': case 'read': case 'page': return this.cat(arg);
        case 'grep': case 'search': case 'find': case 'rg': return this.grep(parts.join(' '));
        case 'pwd': return this.println(this.cwd);
        case 'clear': case 'cls': return this.clear();
        case 'neofetch': case 'fetch': return this.renderNeofetch();
        case 'whoami': return this.println('guest — browsing PES Open Source in developer mode');
        case 'date': return this.println(new Date().toString());
        case 'echo': return this.println(parts.join(' '));
        case 'mode': return arg ? this.pickMode(arg) : this.modeHelp();
        case 'send': case 'mail': case 'message': return this.send();
        case 'exit': case 'quit': case ':q': return leaveDevMode();
        case 'sudo': return this.println('nice try. there is no root here.', 'pt-err');
        case '': return;
        default: return this.bare(cmd);
      }
    }

    bare(token) {
      const target = resolvePath(this.cwd, token);
      if (this.entries[target]) return this.cat(token);
      if (this.childrenOf(target).length) return this.cd(token);
      this.println('command not found: ' + token + "  (try 'help')", 'pt-err');
    }

    /* ---- filesystem ------------------------------------------------- */
    childrenOf(dir) {
      const prefix = dir === '/' ? '/' : dir + '/';
      const map = new Map();
      for (const p of this.paths) {
        if (p === dir || !p.startsWith(prefix)) continue;
        const rest = p.slice(prefix.length);
        const seg = rest.split('/')[0];
        const childPath = prefix + seg;
        const deeper = rest.includes('/');
        if (!map.has(seg)) {
          map.set(seg, {
            seg,
            path: childPath,
            isDir: deeper || !this.entries[childPath],
            isFile: !!this.entries[childPath],
          });
        } else if (deeper) {
          map.get(seg).isDir = true;
        }
      }
      const rank = (n) =>
        n.isDir
          ? (this.dirIndex[n.path] != null ? this.dirIndex[n.path] : 500)
          : (this.entries[n.path] && this.entries[n.path].order != null
              ? this.entries[n.path].order
              : 900);
      return [...map.values()].sort((a, b) => {
        if (a.isDir !== b.isDir) return a.isDir ? -1 : 1;
        const d = rank(a) - rank(b);
        return d !== 0 ? d : a.seg.localeCompare(b.seg);
      });
    }

    dirHeader(dir) {
      const meta = this.dirs[dir];
      if (!meta) return;
      this.print('<span class="pt-dir">' + esc(meta.title) + '</span>');
      if (meta.blurb) this.println(meta.blurb, 'pt-muted');
      this.println('');
    }

    ls(arg) {
      const dir = arg ? resolvePath(this.cwd, arg) : this.cwd;
      const kids = this.childrenOf(dir);
      if (!kids.length) {
        if (this.entries[dir]) return this.println(this.entries[dir].title, 'pt-file', dir);
        return this.println("ls: cannot access '" + (arg || dir) + "': no such directory", 'pt-err');
      }
      this.dirHeader(dir);
      for (const k of kids) {
        const name = k.isDir ? k.seg + '/' : k.seg;
        const e = !k.isDir ? this.entries[k.path] : null;
        const date = e && e.date ? e.date + '  ' : '';
        const title = e ? e.title : '';
        const div = this.print(
          '<span class="pt-ico ' + (k.isDir ? 'pt-ico-dir' : 'pt-ico-file') + '">' +
            (k.isDir ? DIR_ICON : FILE_ICON) + '</span>' +
          '<span class="' + (k.isDir ? 'pt-dir' : 'pt-file') + '">' + esc(name.padEnd(22)) + '</span>' +
          (date ? '<span class="pt-muted">' + esc(date) + '</span>' : '') +
          (title ? '<span class="pt-muted">' + esc(title) + '</span>' : '')
        );
        div.dataset.path = k.path;
      }
    }

    tree(dir, prefix) {
      if (dir === '/') this.println('/');
      const kids = this.childrenOf(dir);
      kids.forEach((k, i) => {
        const last = i === kids.length - 1;
        const div = this.print(
          '<span class="pt-muted">' + esc(prefix + (last ? '└─ ' : '├─ ')) + '</span>' +
          '<span class="pt-ico ' + (k.isDir ? 'pt-ico-dir' : 'pt-ico-file') + '">' +
            (k.isDir ? DIR_ICON : FILE_ICON) + '</span>' +
          '<span class="' + (k.isDir ? 'pt-dir' : 'pt-file') + '">' +
            esc(k.isDir ? k.seg + '/' : k.seg) + '</span>'
        );
        div.dataset.path = k.path;
        if (k.isDir) this.tree(k.path, prefix + (last ? '   ' : '│  '));
      });
    }

    cd(arg) {
      if (!arg || arg === '/' || arg === '~') {
        this.cwd = '/';
        this.setPrompt();
        this.syncUrl('/');
        return this.ls();
      }
      if (arg === '-' && this.currentDoc) arg = this.currentDoc;
      const target = resolvePath(this.cwd, arg);
      if (target === '/' || this.childrenOf(target).length) {
        this.cwd = target;
        this.setPrompt();
        this.syncUrl(this.dirRoute(target));
        this.ls();
      } else if (this.entries[target]) {
        this.println('cd: not a directory: ' + arg + "  (try 'cat " + arg + "')", 'pt-err');
      } else {
        this.println('cd: no such directory: ' + arg, 'pt-err');
      }
    }

    cat(arg) {
      if (!arg) return this.println('usage: cat <path>', 'pt-err');
      const target = resolvePath(this.cwd, arg);
      const entry = this.entries[target];
      if (!entry) {
        if (this.childrenOf(target).length)
          return this.println('cat: ' + arg + ": is a directory (try 'ls " + arg + "')", 'pt-err');
        return this.println('cat: ' + arg + ': no such file', 'pt-err');
      }
      this.openPager(target);
    }

    /* ---- send: the contact form, as prompts --------------------------- */
    ask(label) {
      return new Promise((resolve, reject) => {
        this.asking = { resolve, reject };
        this.setPrompt(label);
        this.focus();
      });
    }
    answer(v) {
      const a = this.asking;
      this.asking = null;
      a.resolve(v);
    }
    cancelAsk() {
      const a = this.asking;
      if (!a) return;
      this.asking = null;
      this.println('^C', 'pt-muted');
      a.reject(new Error('cancelled'));
    }

    // Same fields, checks and endpoint as the form on /contact/ (main.ts initForms).
    async send() {
      const url = this.meta.formspree;
      const subjects = this.meta.subjects || [];
      if (!url) return this.println('send: the contact form is unavailable right now', 'pt-err');
      this.println('send a message to PES Open Source   (Ctrl+C to cancel)', 'pt-doc-head');
      try {
        let name, email, subject, message;
        while (!(name = await this.ask('name?'))) this.println('Please enter your name.', 'pt-err');
        while (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test((email = await this.ask('email?'))))
          this.println('Please enter a valid email.', 'pt-err');
        subjects.forEach((sub, i) =>
          this.print('  <span class="pt-file">[' + (i + 1) + ']</span> ' + esc(sub))
        );
        for (;;) {
          const v = await this.ask('subject?');
          subject = subjects[parseInt(v, 10) - 1] || subjects.find((x) => x.toLowerCase() === v.toLowerCase());
          if (subject) break;
          this.println('Please pick a subject (1–' + subjects.length + ').', 'pt-err');
        }
        for (;;) {
          message = await this.ask('message?');
          if (!message) this.println('Please write a message.', 'pt-err');
          else if (message.length > 1000) this.println('Max 1000 characters (that was ' + message.length + ').', 'pt-err');
          else break;
        }
        const ok = await this.ask('send? [y/N]');
        if (!/^y(es)?$/i.test(ok)) return this.println('not sent.', 'pt-muted');
        this.println('sending …', 'pt-muted');
        const fd = new FormData();
        fd.append('name', name);
        fd.append('email', email);
        fd.append('subject', subject);
        fd.append('message', message);
        const res = await fetch(url, { method: 'POST', body: fd, headers: { Accept: 'application/json' } });
        if (!res.ok) throw new Error('bad status');
        this.println("✓ Thanks — your message is on its way. We'll be in touch soon.", 'pt-ok');
      } catch (err) {
        if (err && err.message === 'cancelled') this.println('cancelled.', 'pt-muted');
        else this.println('Something went wrong sending that — please try again, or reach us on Slack instead.', 'pt-err');
      } finally {
        this.asking = null;
        this.setPrompt();
      }
    }

    /* ---- pager (man / less) --------------------------------------------- */
    bindPager() {
      this.pagerBody.tabIndex = 0;
      document.addEventListener('keydown', (e) => { if (this.paging) this.pagerKey(e); });
    }

    openPager(path, find) {
      const e = this.entries[path];
      if (!e) return this.println('cat: ' + path + ': no such file', 'pt-err');
      this.currentDoc = path;
      this.pagerTitle = e.title;
      const meta = [
        e.type,
        e.date,
        e.tags && e.tags.length ? '#' + e.tags.join(' #') : '',
        e.author,
      ].filter(Boolean).join('   ·   ');
      this.pagerBody.innerHTML =
        '<div class="pt-doc">' +
          '<span class="pt-doc-title">' + esc(e.title) + '</span>\n' +
          (meta ? '<span class="pt-muted">' + esc(meta) + '</span>\n' : '') +
          '<span class="pt-muted">' + esc(path) + '</span>\n\n' +
          renderMarkdown(e.body) +
        '</div>';
      this.pager.hidden = false;
      this.paging = true;
      if (find) this.highlightIn(this.pagerBody, find);
      this.pagerBody.scrollTop = 0;
      if (find) {
        const first = this.pagerBody.querySelector('.pt-find');
        if (first) first.scrollIntoView({ block: 'center' });
      }
      this.cwd = path.replace(/\/[^/]*$/, '') || '/';
      this.setPrompt();
      this.updatePagerStatus();
      this.nyan.sync();
      this.syncUrl(e.route, e.title);
      try { this.pagerBody.focus({ preventScroll: true }); } catch (err) {}
    }

    highlightIn(container, term) {
      let rx;
      try { rx = new RegExp(reQuote(term), 'i'); } catch (e) { return; }
      const walker = document.createTreeWalker(container, NodeFilter.SHOW_TEXT);
      const targets = [];
      let n;
      while ((n = walker.nextNode())) {
        if (n.parentNode && n.parentNode.closest('.pt-code-pre')) continue;
        if (rx.test(n.nodeValue)) targets.push(n);
      }
      for (const node of targets) {
        const s = node.nodeValue;
        const g = new RegExp(reQuote(term), 'ig');
        const frag = document.createDocumentFragment();
        let last = 0;
        let m;
        while ((m = g.exec(s))) {
          if (m.index > last) frag.appendChild(document.createTextNode(s.slice(last, m.index)));
          const mk = document.createElement('mark');
          mk.className = 'pt-find';
          mk.textContent = m[0];
          frag.appendChild(mk);
          last = m.index + m[0].length;
          if (m[0].length === 0) g.lastIndex++;
        }
        if (last < s.length) frag.appendChild(document.createTextNode(s.slice(last)));
        node.parentNode.replaceChild(frag, node);
      }
    }

    grep(term) {
      term = (term || '').trim();
      if (!term) return this.println('usage: grep <text>   (or  /text )', 'pt-err');
      let rx;
      try { rx = new RegExp(reQuote(term), 'i'); } catch (e) { return this.println('bad pattern', 'pt-err'); }
      const paths = Object.keys(this.entries).filter((p) => this.entries[p].body);
      this.println('searching ' + paths.length + ' pages for "' + term + '" …', 'pt-muted');
      let files = 0;
      let hits = 0;
      for (const p of paths) {
        const e = this.entries[p];
        const lines = e.body.split('\n');
        const matched = [];
        for (let i = 0; i < lines.length && matched.length < 4; i++) {
          if (rx.test(lines[i])) matched.push([i + 1, lines[i]]);
        }
        if (!matched.length) continue;
        files++;
        hits += matched.length;
        const head = this.print(
          '<span class="pt-ico pt-ico-file">' + FILE_ICON + '</span>' +
          '<span class="pt-file">' + esc(p) + '</span>  <span class="pt-muted">' + esc(e.title) + '</span>'
        );
        head.dataset.path = p;
        head.dataset.find = term;
        for (const [ln, text] of matched) {
          let snip = text.trim();
          if (snip.length > 120) {
            const at = Math.max(0, snip.search(rx));
            snip = (at > 40 ? '…' : '') + snip.slice(Math.max(0, at - 40), at + 80) + '…';
          }
          const html = esc(snip).replace(new RegExp('(' + reQuote(term) + ')', 'ig'), '<span class="pt-match">$1</span>');
          const row = this.print('<span class="pt-muted">  ' + String(ln).padStart(4) + ' │ </span>' + html);
          row.dataset.path = p;
          row.dataset.find = term;
        }
      }
      if (!files) this.println('no matches.', 'pt-err');
      else this.println(hits + ' match' + (hits === 1 ? '' : 'es') + ' in ' + files + ' file' + (files === 1 ? '' : 's') + '  ·  click a result to open it', 'pt-ok');
    }

    closePager() {
      if (!this.paging) return;
      this.paging = false;
      this.pager.hidden = true;
      this.pagerBody.innerHTML = '';
      this.nyan.sync();
      this.focus();
    }

    updatePagerStatus() {
      if (!this.paging) return;
      const sc = this.pagerBody;
      const lh = parseFloat(getComputedStyle(sc).lineHeight) || 20;
      const total = Math.max(1, Math.round(sc.scrollHeight / lh));
      const atTop = sc.scrollTop <= 1;
      const atEnd = sc.scrollTop + sc.clientHeight >= sc.scrollHeight - 1;
      const cur = Math.min(total, Math.round(sc.scrollTop / lh) + 1);
      const where = atEnd ? '(END)' : atTop ? 'line 1' : 'line ' + cur;
      const coarse = window.matchMedia('(pointer: coarse)').matches;
      const hint = coarse
        ? 'tap this bar to quit'
        : 'j/k ↑↓ scroll · space/b page · g/G ends · q quit';
      this.pagerStatus.textContent =
        this.pagerTitle + '  ' + where + '/' + total + '   ·   ' + hint;
    }

    pagerKey(e) {
      if (!this.paging) return;
      const sc = this.pagerBody;
      const page = Math.max(40, sc.clientHeight - 40);
      const lh = parseFloat(getComputedStyle(sc).lineHeight) || 20;
      const k = e.key;
      let handled = true;
      if (k === 'q' || k === 'Escape') { e.preventDefault(); this.closePager(); return; }
      else if (k === 'j' || k === 'ArrowDown') sc.scrollTop += lh * 2;
      else if (k === 'k' || k === 'ArrowUp') sc.scrollTop -= lh * 2;
      else if (k === ' ' || k === 'PageDown' || k === 'f') sc.scrollTop += page;
      else if (k === 'b' || k === 'PageUp') sc.scrollTop -= page;
      else if (k === 'd') sc.scrollTop += page / 2;
      else if (k === 'u') sc.scrollTop -= page / 2;
      else if (k === 'g' || k === 'Home') sc.scrollTop = 0;
      else if (k === 'G' || k === 'End') sc.scrollTop = sc.scrollHeight;
      else handled = false;
      if (handled) { e.preventDefault(); this.updatePagerStatus(); this.nyan.sync(); }
    }

    // website route of a terminal directory (nearest ancestor with one)
    dirRoute(dir) {
      for (let d = dir; d; d = d.replace(/\/[^/]*$/, '')) {
        if (this.dirs[d] && this.dirs[d].route) return this.dirs[d].route;
      }
      return '/';
    }

    // Keep the address bar on the website route of the last page opened
    // (cat) or section entered (cd). Quitting the pager doesn't move it, so
    // "read about, q, `" lands on /about/.
    syncUrl(route, title) {
      if (this.restoring) return;
      this.moved = true;
      this.route = route;
      try { history.replaceState({}, '', BASE + route); } catch (err) {}
      document.title = title ? title + ' · PESOS' : this.loadedTitle;
    }

    openForLocation() {
      this.restoring = true;
      fitLogo(this.print('<pre class="pt-hero">' + heroHtml() + '</pre>').querySelector('pre'));
      if (this.entries['/']) this.print(renderMarkdown(this.entries['/'].body), 'pt-doc');
      this.println('');
      this.ls('/');
      // the page we're on (or a legacy #path link) -> its terminal path
      const hash = (location.hash || '').replace(/^#\/?/, '/');
      const here = this.entries[hash] && hash !== '/' ? hash : SITEMAP[normalizePath(location.pathname)];
      if (here && here !== '/') {
        if (this.entries[here]) this.openPager(here);
        else this.cd(here);
      }
      this.restoring = false;
      this.moved = false;
    }

    /* ---- boot + neofetch --------------------------------------------- */
    renderNeofetch() {
      const m = this.meta || {};
      const logo = heroHtml();
      const rows = [
        ['OS', 'PES Open Source'],
        ['Host', 'pes.community'],
        ['Kernel', 'astro · static site'],
        ['Uptime', 'since ' + (m.founded || 2012)],
        ['Shell', 'pesh 1.0'],
        ['Theme', 'PESOS (matches the site)'],
        ['Sections', Object.keys(this.dirs).length + ' · run tree'],
        ['Pages', String(m.pages != null ? m.pages : this.paths.length)],
        ['Posts', String(m.posts != null ? m.posts : '')],
        ['Toggle', 'Ctrl+T  or  `'],
      ];
      const info = [
        '<span class="pt-neo-title">guest@pesos</span>',
        '<span class="pt-neo-rule">' + '─'.repeat(11) + '</span>',
        ...rows.map(([k, v]) => '<span class="k">' + esc((k + ':').padEnd(10)) + '</span>' + esc(v)),
      ].join('\n');
      const swatch = [
        '--ptn-bg-hl', '--ptn-red', '--ptn-orange', '--ptn-green',
        '--ptn-teal', '--ptn-comment', '--ptn-fg-dim', '--ptn-fg',
      ].map((c) => '<i style="background:var(' + c + ')"></i>').join('');
      fitLogo(this.print(
        '<div class="pt-neo pt-scan">' +
          '<pre>' + logo + '</pre>' +
          '<div class="pt-neo-info">' + info + '\n\n<span class="pt-swatch">' + swatch + '</span></div>' +
        '</div>'
      ).querySelector('pre'));
    }

    async runBoot(rain) {
      this.booting = true;
      this.input.disabled = true;
      if (rain) await rain;
      this.root.classList.remove('pt-raining');
      this.clear();
      this.reveal = 0;
      this.renderNeofetch();
      this.println('');
      this.println('select mode:  (type 1 / 2, or tap)', 'pt-doc-head');
      this.print('  <span class="pt-file" data-mode="1">[1] developer</span>  <span class="pt-muted">browse the whole site in this terminal</span>');
      this.print('  <span class="pt-file" data-mode="2">[2] normal</span>     <span class="pt-muted">the regular website</span>');
      this.println('');
      this.reveal = null;
      this.booting = false;
      this.input.disabled = false;
      this.awaitingMode = true;
      this.setPrompt('mode?');
      this.focus();
    }

    pickMode(v) {
      const s = String(v).trim().toLowerCase();
      if (['1', 'd', 'dev', 'developer'].includes(s)) {
        this.awaitingMode = false;
        try { sessionStorage.setItem(BOOT_KEY, '1'); } catch (e) {}
        setMode('dev');
        this.fadeOut(() => {
          this.reveal = 0;
          this.println('developer mode. "help" for commands, "exit" for the normal site.', 'pt-ok');
          this.println('');
          this.setPrompt();
          this.openForLocation();
          this.reveal = null;
          this.enableSmooth();
          this.focus();
        });
      } else if (['2', 'n', 'no', 'normal', 'non-dev', 'nondev'].includes(s)) {
        this.awaitingMode = false;
        try { sessionStorage.setItem(BOOT_KEY, '1'); } catch (e) {}
        leaveDevMode();
      } else {
        this.println('pick 1 or 2', 'pt-err');
      }
    }

    modeHelp() {
      this.println('mode 1  developer terminal (this)');
      this.println('mode 2  normal website');
    }

    help() {
      const rows = [
        ['ls [path]', 'list a section  (auto-runs when you cd)'],
        ['cd <dir>', 'enter a section, e.g. about/   ("cd /" = home)'],
        ['cat <file>', 'read a page in the pager  (q to quit)'],
        ['grep <text>', 'search every page  (shortcut:  /text )'],
        ['tree', 'show the whole site'],
        ['neofetch', 'the splash panel again'],
        ['pwd', 'where am I'],
        ['clear', 'clear the screen  (Ctrl+L)'],
        ['send', 'send us a message  (the contact form)'],
        ['mode [1|2]', '1 = this terminal, 2 = normal website'],
        ['exit', 'leave developer mode'],
      ];
      this.println('commands', 'pt-doc-head');
      for (const [c, d] of rows) this.print('  <span class="pt-file">' + esc(c.padEnd(14)) + '</span><span class="pt-muted">' + esc(d) + '</span>');
      this.println('');
      this.println('getting around', 'pt-doc-head');
      this.println('  type a name directly — e.g. "about", "blogs", "showcase"');
      this.println('  Tab completes commands and paths; Tab twice lists options');
      this.println('  click any highlighted path or link');
      this.println('  `   (backtick)  toggle the normal website from anywhere');
    }

    /* ---- effects ---------------------------------------------------- */
    // Switching back in from the website: matrix rain first, then the page.
    async reenter() {
      if (!reducedMotion()) {
        this.root.classList.add('pt-raining');
        this.input.disabled = true;
        await this.matrix();
        this.input.disabled = false;
        this.root.classList.remove('pt-raining');
      }
      this.setPrompt();
      this.openForLocation();
      this.enableSmooth();
      this.focus();
    }

    // Matrix rain over the whole terminal. Columns fall from above the top
    // and start again when they pass the bottom; once the screen has been
    // covered, the rain fades out while still falling, and the promise
    // resolves early in that fade so the next screen fades in underneath.
    matrix() {
      return new Promise((resolve) => {
        const c = this.canvas;
        const ctx = c && c.getContext('2d');
        if (!ctx) return resolve();
        const dpr = window.devicePixelRatio || 1;
        const w = c.clientWidth || window.innerWidth;
        const h = c.clientHeight || window.innerHeight;
        c.width = w * dpr;
        c.height = h * dpr;
        ctx.scale(dpr, dpr);
        c.classList.add('on');
        const glyphs = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789<>[]{}/\\$#@=+*';
        const size = 16;
        const rows = Math.ceil(h / size);
        const SPEED = 1.6; // average rows per tick
        const cols = Array.from({ length: Math.ceil(w / size) }, () => ({
          y: -Math.random() * rows * 0.5,
          v: SPEED * (0.6 + Math.random() * 0.8),
        }));
        // long enough for the average column to reach the bottom
        const runMs = Math.min(2400, Math.max(1000, (rows * 1.5 / SPEED) * 33));
        ctx.font = size + 'px "JetBrains Mono", monospace';
        // the palette (and so the current site theme) decides the colours
        const pal = getComputedStyle(document.documentElement);
        const bg = pal.getPropertyValue('--ptn-bg').trim();
        const trail = pal.getPropertyValue('--ptn-green').trim();
        const head = pal.getPropertyValue('--ptn-fg').trim();
        const tick = () => {
          ctx.globalAlpha = 0.14;
          ctx.fillStyle = bg;
          ctx.fillRect(0, 0, w, h);
          ctx.globalAlpha = 1;
          cols.forEach((col, i) => {
            const from = Math.floor(col.y);
            col.y += col.v;
            const to = Math.floor(col.y);
            // every row passed this tick gets a glyph (no gaps in fast
            // columns): the accent for the trail, a bright head
            for (let r = Math.max(from + 1, 1); r <= to; r++) {
              ctx.fillStyle = r === to ? head : trail;
              ctx.fillText(glyphs[(Math.random() * glyphs.length) | 0], i * size, r * size);
            }
            if (col.y > rows + 6) col.y = -Math.random() * 8;
          });
        };
        const iv = setInterval(tick, 33);
        setTimeout(() => {
          c.classList.remove('on'); // CSS fades the canvas out over 0.8s
          setTimeout(resolve, 250);
          setTimeout(() => { clearInterval(iv); ctx.clearRect(0, 0, w, h); }, 900);
        }, runMs);
      });
    }

    installFire() {
      if (document.getElementById('pesos-fire')) return;
      this.fireEl = document.createElement('div');
      this.fireEl.id = 'pesos-fire';
      this.root.appendChild(this.fireEl);
    }
    fire() {
      this.animating = true;
      this.input.disabled = true;
      this.fireEl.classList.add('on');
      setTimeout(() => {
        this.fireEl.classList.remove('on');
        this.println('');
        this.println("\u{1F525} and that is why we don't run that command.", 'pt-err');
        this.animating = false;
        this.input.disabled = false;
        this.focus();
      }, 1800);
    }
  }

  /* ---- module-level wiring ------------------------------------------- */
  let term = null;
  const root = document.getElementById('pesos-terminal');

  function ensureTerm(opts) {
    if (!root) return;
    if (!term) term = new PesosTerminal(root);
    term.start(opts || { boot: false });
  }

  // website -> terminal: always starts with the matrix rain
  function enterDevMode() {
    setMode('dev');
    if (!term) ensureTerm({ boot: false, rain: true });
    else term.reenter();
    if (term) term.focus();
  }

  // terminal -> website: always the home page. If the page under the
  // terminal already is home, just swap back; otherwise load home. Only the
  // stored mode flips first, so the terminal stays up until home paints.
  function leaveDevMode() {
    const loaded = term && term.loadedHref ? new URL(term.loadedHref).pathname : location.pathname;
    if (normalizePath(loaded) !== '/') {
      try { sessionStorage.setItem(MODE_KEY, 'normal'); } catch (e) {}
      location.assign(BASE + '/');
      return;
    }
    if (term && term.paging) { term.restoring = true; term.closePager(); term.restoring = false; }
    setMode('normal');
    try {
      if (term && term.loadedHref && location.href !== term.loadedHref) {
        history.replaceState({}, '', term.loadedHref);
      }
      if (term) { document.title = term.loadedTitle; term.moved = false; }
    } catch (e) {}
    window.scrollTo(0, 0);
  }
  window.__pesosLeaveDevMode = leaveDevMode;

  function onKey(e) {
    const t = e.target;
    const typing =
      t && (t.tagName === 'INPUT' || t.tagName === 'TEXTAREA' || t.isContentEditable);
    const ctrlT =
      e.ctrlKey && !e.metaKey && !e.altKey && (e.key === 't' || e.key === 'T');
    const tick =
      e.key === '`' && !e.ctrlKey && !e.metaKey && !e.altKey;
    if (!ctrlT && !tick) return;
    // backtick stays a normal key while the pager is open (q quits there)
    if (tick && term && term.paging) return;
    if (tick && typing && !(term && t === term.input)) return;
    e.preventDefault();
    if (document.documentElement.classList.contains('mode-dev')) leaveDevMode();
    else enterDevMode();
  }

  document.addEventListener('keydown', onKey, true);

  // the nav's ">_ Terminal" links (the nav itself isn't changed for this)
  const toggles = [
    ...document.querySelectorAll('.term-btn'),
    ...[...document.querySelectorAll('.nav__drawer a[href="#"]')].filter((a) => /terminal/i.test(a.textContent || '')),
  ];
  toggles.forEach((el) =>
    el.addEventListener('click', (e) => { e.preventDefault(); enterDevMode(); })
  );

  // a page load in terminal mode (reload, or a page loaded from the terminal)
  // carries straight on: no rain, no boot screen
  if (document.documentElement.classList.contains('mode-dev')) {
    ensureTerm({ boot: false });
  }
</script>
