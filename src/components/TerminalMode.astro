  /* ---- nyan cat scrollbar ------------------------------------------------ */
  class Nyan {
    constructor(el, getScroller) {
      this.el = el;
      this.rain = el.querySelector('.pt-nyan-rain');
      this.cat = el.querySelector('.pt-nyan-cat');
      this.getScroller = getScroller;
      this.drag = false;
      const jump = (e) => {
        const sc = this.getScroller();
        if (!sc) return;
        const r = this.el.getBoundingClientRect();
        const p = Math.min(1, Math.max(0, (e.clientY - r.top) / r.height));
        sc.scrollTop = p * (sc.scrollHeight - sc.clientHeight);
