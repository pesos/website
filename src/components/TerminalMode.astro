<style is:global>
  /* ---- palette: the website's own ----------------------------------- */
  /* Same tokens as src/styles/global.css (dark default, light override), so
     the terminal looks like the rest of the site and follows its theme. The
     --ptn-* names are roles used throughout the rules below:
       blue = main accent (dirs, headings, prompt), cyan = links,
       magenta/teal = secondary accent, yellow = bold, orange/red = numbers
       and errors (the site has no tokens for those two). */
  :root {
    --ptn-bg: #0b0e0d;                       /* --bg */
    --ptn-bg-dark: #090c0b;                  /* --bg-inset: code blocks */
    --ptn-bg-hl: #161b19;                    /* a step above --bg-card */
    --ptn-fg: #f8f3ef;                       /* --text */
    --ptn-fg-dim: rgba(248, 243, 239, 0.66); /* --text-dim */
    --ptn-comment: rgba(248, 243, 239, 0.42);/* --text-mute */
    --ptn-red: #ff5c5c;                      /* the site's form-error red */
    --ptn-orange: #f5b971;
    --ptn-yellow: #f8f3ef;                   /* bold = bright text, like .prose strong */
    --ptn-green: #3ecf8e;                    /* --neon */
    --ptn-teal: #94e6b7;                     /* --neon-2 */
    --ptn-cyan: #94e6b7;
    --ptn-blue: #3ecf8e;
    --ptn-blue0: rgba(62, 207, 142, 0.34);   /* --neon-line */
    --ptn-magenta: #94e6b7;
    /* Text size, matching the website's 15px body text. The terminal fills
       the window and sizes text in px, so browser zoom works like on any
       page: text grows or shrinks and lines reflow to the new width. The
       nyan scrollbar and the matrix rain are pinned to the screen in
       viewport units, the same size at any zoom. */
    --pt-font: 15px;
  }

  :root[data-theme='light'] {
    --ptn-bg: #fbfaf8;
    --ptn-bg-dark: #f2f0ec;
    --ptn-bg-hl: #ebe8e2;
    --ptn-fg: #10201a;
    --ptn-fg-dim: #4d5a54;
    --ptn-comment: #7c8781;
    --ptn-red: #d33a3a;
    --ptn-orange: #b4691b;
    --ptn-yellow: #10201a;
    --ptn-green: #0f8f56;
    --ptn-teal: #0b6e43;
    --ptn-cyan: #0f8f56;
    --ptn-blue: #0f8f56;
    --ptn-blue0: rgba(15, 143, 86, 0.32);
    --ptn-magenta: #0b6e43;
  }

  /* ---- mode switching + smooth toggle -------------------------------- */
  #pesos-terminal { display: none; }
  html.mode-dev #pesos-terminal,
  html.mode-normal #pesos-terminal { display: flex; }

  html.mode-dev,
  html.mode-dev body {
    height: 100%;
    overflow: hidden;
    background: var(--ptn-bg);
  }
  /* the website: every other child of <body>. The fade only exists while
     switching (html.pt-switching), so the website's own styles are never
     touched while it's showing. */
  html.pt-switching body > :not(#pesos-terminal) { transition: opacity 0.3s ease; }
  html.mode-dev body > :not(#pesos-terminal) { opacity: 0; }

  #pesos-terminal {
    position: fixed;
    inset: 0;
    z-index: 2147483000;
    flex-direction: column;
    overflow: hidden;
    background: var(--ptn-bg);
    color: var(--ptn-fg);
    font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, 'SF Mono', Menlo, monospace;
    font-size: var(--pt-font);
    line-height: 1.6;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(6px);
    transition: opacity 0.3s ease, transform 0.3s ease, visibility 0.3s;
  }
  html.mode-dev #pesos-terminal {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: none;
  }


  /* ---- chrome --------------------------------------------------------- */
  #pesos-terminal .pt-matrix {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.8s ease;
  }
  #pesos-terminal .pt-matrix.on { opacity: 0.4; }

  #pesos-terminal .pt-window,
  #pesos-terminal .pt-pager-body {
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    overscroll-behavior: contain;
  }
  #pesos-terminal .pt-window::-webkit-scrollbar,
  #pesos-terminal .pt-pager-body::-webkit-scrollbar { width: 0; height: 0; }

  #pesos-terminal .pt-window {
    position: relative;
    z-index: 1;
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: 1.25em 3.2em 1.25em 2.85em;
    overflow-y: auto;
    overflow-x: hidden;
  }
  #pesos-terminal .pt-window.pt-smooth,
  #pesos-terminal .pt-pager-body.pt-smooth { scroll-behavior: smooth; }

  #pesos-terminal .pt-scrollback {
    white-space: pre-wrap;
    word-break: break-word;
  }
  #pesos-terminal .pt-line { margin: 1px 0; }
  /* boot / mode-switch reveal: lines fade up one after another, the logo
     scans in top to bottom, and a screen being replaced fades out */
  #pesos-terminal .pt-enter { animation: pt-enter 0.45s ease both; }
  @keyframes pt-enter { from { opacity: 0; transform: translateY(5px); } to { opacity: 1; transform: none; } }
  #pesos-terminal .pt-scan pre { animation: pt-scan 0.9s ease-out both; }
  @keyframes pt-scan { from { clip-path: inset(0 0 100% 0); } to { clip-path: inset(0 0 0 0); } }
  #pesos-terminal .pt-scrollback { transition: opacity 0.2s ease; }
  #pesos-terminal .pt-scrollback.pt-fading { opacity: 0; }
