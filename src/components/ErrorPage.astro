---
/* Shared error page. Renders `code` at build time; with `dynamic`, a script
   swaps in the code from ?code= at runtime (unknown codes fall back to a
   generic message). The search box opens the site search dialog. */
import { ERRORS } from '../data/errors';
interface Props { code: string; dynamic?: boolean; }
const { code, dynamic = false } = Astro.props;
const e = ERRORS[code] ?? { title: 'Error', msg: 'Something went wrong.' };
---
<section class="wrap section" style="text-align:center;max-width:720px" data-error={dynamic ? '' : undefined}>
  <div class="big-404" data-error-code>{code}</div>
  <h1 class="h2" style="margin-top:8px" data-error-title>{e.title}</h1>
  <p class="lead" style="margin:12px auto 24px" data-error-msg>{e.msg}</p>
  <form class="search" style="max-width:440px;margin:0 auto 20px" data-error-search>
    <span class="search__icon">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
    </span>
    <input class="input" type="search" name="q" placeholder="Search pages…" aria-label="Search the site" />
  </form>
  <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap">
    <a class="btn btn--primary" href="/">Back to home</a>
  </div>
</section>

<script define:vars={{ ERRORS }}>
  const root = document.querySelector('[data-error]');
  if (root) {
    const code = new URLSearchParams(location.search).get('code');
    if (code && /^\d{3}$/.test(code)) {
      const e = ERRORS[code] || { title: 'Error', msg: 'Something went wrong.' };
      root.querySelector('[data-error-code]').textContent = code;
      root.querySelector('[data-error-title]').textContent = e.title;
      root.querySelector('[data-error-msg]').textContent = e.msg;
      document.title = `${code}: ${e.title} · PESOS`;
    }
  }
  document.querySelector('[data-error-search]')?.addEventListener('submit', (ev) => {
    ev.preventDefault();
    const q = ev.currentTarget.querySelector('input').value;
    window.dispatchEvent(new CustomEvent('pesos:search', { detail: q }));
  });
</script>
