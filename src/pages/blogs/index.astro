---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Crumb from '@/components/Crumb.astro';
import SectionTabs from '@/components/SectionTabs.astro';
import SectionHeader from '@/components/SectionHeader.astro';

import { getAllPosts } from '@/lib/posts';

const posts = await getAllPosts();
// one chip per tag actually in use, so a new tag in a post gets its own chip
const tags = ['All', ...new Set(posts.map((p) => p.tag))];
---

<BaseLayout title="Blogs" description="Articles, tutorials and field notes from the PES Open Source community.">
  <section class="wrap page-head">
    <Crumb items={[{ label: 'Blogs and Resources' }, { label: 'Blogs' }]} />
    <div style="margin-top:22px"><SectionTabs section="Blogs and Resources" /></div>
  </section>

  <section class="wrap listing" style="padding-block:24px 40px">
    <div class="listing__head">
    <span class="eyebrow eyebrow--pill" style="margin:0 auto">Blogs</span>
    <h1 class="display" style="margin:20px 0 16px">Articles, tutorials and field notes</h1>
    </div>
    <div data-filter-root>
      <div class="listing__head">
      <div class="search" style="max-width:460px;margin:0 auto 18px">
        <span class="search__icon">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        </span>
        <input class="input" type="search" placeholder="Search posts…" data-filter-search />
      </div>
      <div class="tabs" style="justify-content:center">
        {tags.map((t, i) => (
          <button class:list={['chip', i === 0 && 'is-active']} data-filter={t} data-filter-key="cat" type="button">{t}</button>
        ))}
      </div>
      </div>

      <div style="margin-top:56px">
        <SectionHeader title="All Posts" />
        <div class="grid-3">
          {posts.map((p, i) => (
            <article class="card card--spotlight reveal" data-item data-cat={p.tag} style={`--d:${i * 50}ms`}>
              <div class="img-ph" style="min-height:140px;margin-bottom:16px">Cover</div>
              <span class:list={['tag', p.featured && 'tag--neon']}>{p.featured ? `Featured · ${p.tag}` : p.tag}</span>
              <h3 class="h3" style="margin:10px 0 6px">{p.title}</h3>
              <p class="muted" style="font-size:.9rem;margin-bottom:10px">{p.description}</p>
              <div class="mono muted" style="font-size:.76rem;margin-bottom:14px">
                {[p.author, p.dateLabel, p.readMins && `${p.readMins} min read`].filter(Boolean).join(' · ')}
              </div>
              {p.external
                ? <a class="link-arrow" href={p.href} target="_blank" rel="noopener">Read on GitHub ↗</a>
                : <a class="link-arrow" href={p.href}>Read article →</a>}
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
