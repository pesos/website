---
import BaseLayout from '../layouts/BaseLayout.astro';
import Crumb from '../components/Crumb.astro';
import SectionHeader from '../components/SectionHeader.astro';
import ImgPlaceholder from '../components/ImgPlaceholder.astro';
import { ACTIVITIES, ACTIVITY_TYPES } from '../data/events';
import { LINKS } from '../data/site';

const featured = ACTIVITIES.find((a) => a.featured)!;
const rest = ACTIVITIES.filter((a) => !a.featured);
---

<BaseLayout title="Events & Activities" description="What PESOS actually runs, and how often — plus where to find out what's next.">
  <section class="wrap page-head">
    <Crumb items={[{ label: 'Community' }, { label: 'Events' }]} />
    <h1 class="h1" style="margin:14px 0 10px">Events & Activities</h1>
    <p class="lead">
      We don't keep a public calendar with fixed dates — specific meet-ups, workshops and talks
      are announced on Slack and Discord as they're scheduled. Here's the shape of what we
      actually run, and how often.
    </p>
    <div style="margin-top:20px">
      <a class="btn btn--primary btn--sm" href={LINKS.slack} target="_blank" rel="noopener">See what's next on Slack</a>
    </div>
  </section>

  <section class="wrap section" data-filter-root>
    <div class="tabs" style="margin-bottom:44px">
      {ACTIVITY_TYPES.map((t, i) => (
        <button class:list={['chip', i === 0 && 'is-active']} data-filter={t} data-filter-key="cat" type="button">{t}</button>
      ))}
    </div>

    <SectionHeader num="01" title="Our Most Regular Activity" center />
    <div class="split reveal" style="margin-bottom:60px">
      <div class="split__media"><ImgPlaceholder label="Meet-up photo" style="border:0;height:100%" /></div>
      <div class="split__body">
        <span class="tag">{featured.type}</span>
        <h2 class="h2">{featured.title}</h2>
        <p class="muted">{featured.blurb}</p>
        <div class="mono muted" style="font-size:.8rem">{featured.cadence}</div>
        <a class="btn btn--ghost btn--sm" href="/how-to-join/">How to join in →</a>
      </div>
    </div>

    <SectionHeader num="02" title="Everything Else We Run" center />
    <div class="grid-3">
      {rest.map((a, i) => (
        <article class="card card--spotlight reveal" data-item data-cat={a.type} style={`--d:${i * 50}ms`}>
          <div class="img-ph" style="min-height:110px;margin-bottom:14px">800×500</div>
          <span class="tag">{a.type}</span>
          <h3 class="h3" style="margin:10px 0 6px">{a.title}</h3>
          <p class="muted" style="font-size:.9rem">{a.blurb}</p>
          <div class="mono muted" style="font-size:.76rem;margin-top:10px">{a.cadence}</div>
        </article>
      ))}
    </div>
  </section>

  <section class="wrap section--tight">
    <div class="panel reveal" style="display:flex;justify-content:space-between;align-items:center;gap:24px;flex-wrap:wrap">
      <div>
        <h3 class="h3">Looking for what we've already done?</h3>
        <p class="muted" style="margin-top:6px">Browse workshops, hackathons and other past events in the archive.</p>
      </div>
      <a class="btn btn--primary" href="/archive/">View past events</a>
    </div>
  </section>
</BaseLayout>
