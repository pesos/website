---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Crumb from '@/components/Crumb.astro';
import SectionTabs from '@/components/SectionTabs.astro';
import SectionHeader from '@/components/SectionHeader.astro';

// Broken out of the club's own mission statement (quoted below), one goal
// per thing it commits the community to.
const goals = [
  { n: '01', t: 'Contribute to open source', d: 'Help the community contribute to open-source projects, right from the first pull request.' },
  { n: '02', t: 'Create open source', d: 'Build and maintain our own projects.' },
  { n: '03', t: 'Critique open source', d: 'Review each other’s code and ideas, grow together' },
  { n: '04', t: 'Advocate for open source', d: 'Spread the word about open source on campus and beyond.' },
  { n: '05', t: 'Build the culture', d: 'Make open-source collaboration a normal part of student life at PES University.' },
  { n: '06', t: 'Learn in public', d: 'Share what we learn through talks, blog posts and firesides' }
];
---

<BaseLayout title="Goals" description="What PES Open Source sets out to do.">
  <section class="wrap page-head">
    <Crumb items={[{ label: 'About' }, { label: 'Goals' }]} />
    <h1 class="h1" style="margin:14px 0 10px">Goals</h1>
    <p class="lead">What this club cares about.</p>
    <div style="margin-top:22px"><SectionTabs section="About" /></div>
  </section>

  <section class="wrap section">
    <div class="panel panel--accent reveal" style="margin-bottom:64px">
      <span class="eyebrow" style="margin-bottom:14px">Mission Statement</span>
      <p class="lead" style="font-style:bold;max-width:none">
        "PES OpenSource is a community that creates freely, collaborates openly, and contributes to what it believes in, recognizing people by their work, not their credentials."
      </p>
    </div>

    <SectionHeader title="What we're working towards" center />
    <div class="grid-auto">
      {goals.map((g, i) => (
        <div class="card card--spotlight reveal" style={`--d:${i * 60}ms`}>
          <span class="mono" style="color:var(--neon);font-size:.85rem">{g.n}</span>
          <h3 class="h3" style="margin:8px 0 6px">{g.t}</h3>
          <p class="muted" style="font-size:.92rem">{g.d}</p>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
