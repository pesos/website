---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { RESOURCES, RESOURCE_FILTERS } from '../data/resources';
---

<BaseLayout title="Resources" description="Guides, tools and open-source repositories curated by our members.">
  <section class="wrap" style="text-align:center;padding-block:clamp(48px,8vw,96px) 40px;max-width:760px">
    <span class="eyebrow eyebrow--pill" style="margin:0 auto">Resources</span>
    <h1 class="display" style="margin:20px 0 16px">Everything you need to build faster and smarter</h1>
    <p class="lead" style="margin:0 auto 26px">
      Browse guides, tools, and open-source repositories curated by our engineering team.
    </p>
    <div data-filter-root>
      <div class="search" style="max-width:460px;margin:0 auto 18px">
        <span class="search__icon">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        </span>
        <input class="input" type="search" placeholder="Search resources…" data-filter-search />
      </div>
      <div class="tabs" style="justify-content:center">
        {RESOURCE_FILTERS.map((f, i) => (
          <button class:list={['chip', i === 0 && 'is-active']} data-filter={f} data-filter-key="cat" type="button">{f}</button>
        ))}
      </div>

      <div style="text-align:left;margin-top:56px">
        <SectionHeader title="All Resources" />
        <div class="grid-3">
          {RESOURCES.map((r, i) => (
            <article class="card card--spotlight reveal" data-item data-cat={r.category} style={`--d:${i * 50}ms`}>
              <div class="img-ph" style="min-height:140px;margin-bottom:16px">Preview</div>
              <span class="tag">{r.category}</span>
              <h3 class="h3" style="margin:10px 0 6px">{r.title}</h3>
              <p class="muted" style="font-size:.9rem;margin-bottom:14px">{r.blurb}</p>
              <a class="link-arrow" href={r.href} target="_blank" rel="noopener">View resource →</a>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
