---
import BaseLayout from '../layouts/BaseLayout.astro';
import ImgPlaceholder from '../components/ImgPlaceholder.astro';
---
<BaseLayout title="404 — Not Found">
  <section class="wrap section" style="text-align:center;max-width:720px">
    <div class="reveal" style="margin-bottom:36px">
      <ImgPlaceholder label="Hero illustration / graphic" style="min-height:280px" />
    </div>
    <div class="big-404">404</div>
    <p class="lead" style="margin:12px auto 24px">This page took a wrong turn in the repo. Try a search or head home.</p>
    <form class="search" style="max-width:440px;margin:0 auto 20px" onsubmit="event.preventDefault()">
      <span class="search__icon">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      </span>
      <input class="input" type="search" placeholder="Search pages…" />
    </form>
    <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap">
      <a class="btn btn--ghost" href="/">Back to home</a>
      <a class="btn btn--primary" href="/getting-started/">Browse pages</a>
    </div>
  </section>
</BaseLayout>
