---
import BaseLayout from '@/layouts/BaseLayout.astro';
import HeroGlyphs from '@/components/HeroGlyphs.astro';
import { SITE, SECTIONS } from '@/data/site';

// Every item is unique and one pass is wider than any viewport, so the
// marquee never shows the same label twice on screen.
const tech = [
  'Linux', 'Git', 'Go', 'Rust', 'Python', 'C', 'C++', 'TypeScript', 'Bash', 'Vim',
  'Neovim', 'Emacs', 'Docker', 'Kubernetes', 'PostgreSQL', 'SQLite', 'Redis', 'Nginx',
  'GCC', 'LLVM', 'Node.js', 'Deno', 'Astro', 'React', 'Django', 'Flask', 'Arch Linux',
  'Debian', 'Fedora', 'tmux', 'GNU Make', 'Wireshark', 'Firefox', 'Blender', 'GIMP',
  'Kdenlive', 'VS Code', 'Jupyter', 'PyTorch', 'NumPy', 'Hugo', 'Jekyll', 'Mastodon',
];
---

<BaseLayout description="PESOS, the student-run open-source community at PES University.">
  <section class="wrap hero">
    <div class="hero__copy">
      <span class="eyebrow">01 // Open Source</span>
      <h1 class="display hero__title">Execute.<br />
        Teach.<br />
        <span style="color:var(--neon)">Contribute.</span></h1>
      <p class="lead">
        {SITE.tagline}
      </p>
      <div class="hero__cta">
        <a class="btn btn--primary" href="/about/how-to-join/">Join the club</a>
        <a class="btn btn--ghost" href="/getting-started/">Explore the club</a>
      </div>
    </div>

    <div class="hero__art" aria-hidden="true">
      <HeroGlyphs />
    </div>
  </section>

  <div class="marquee" aria-hidden="true">
    <div class="marquee__track">
      {/* two identical groups; the track slides exactly one group width, so
          the loop point is seamless. */}
      {[0, 1].map(() => (
        <div class="marquee__group">
          {tech.map((t) => <span>{t}</span>)}
        </div>
      ))}
    </div>
  </div>

  <section class="wrap section">
    <div style="display:flex;justify-content:space-between;align-items:end;gap:20px;flex-wrap:wrap;margin-bottom:32px">
      <span class="eyebrow">02 // Club Sections</span>
    </div>

    <div class="grid-auto">
      {SECTIONS.map((s, i) => (
        <a class="card card--spotlight reveal" href={s.href} style={`--d:${i * 60}ms`}>
          <span class="eyebrow eyebrow--pill" style="margin-bottom:16px">{s.n} // {s.label}</span>
          <div class="card__body">
            <h3 class="h3">{s.title}</h3>
            <p class="muted" style="font-size:.9rem">{s.desc}</p>
            <span class="link-arrow" style="margin-top:8px">{s.cta} →</span>
          </div>
        </a>
      ))}
    </div>
  </section>
  <!--
  <section class="wrap section--tight">
    <div class="panel panel--accent reveal" style="display:flex;justify-content:space-between;align-items:center;gap:28px;flex-wrap:wrap">
      <div>
        <h2 class="h2">Want to start your own project?</h2>
        <p class="muted" style="margin-top:8px;max-width:52ch">
          Have an idea for a compiler, a tool, or a developer utility? PESOS provides
          infrastructure, guidance, and peer contributors to help launch your initiative.
        </p>
      </div>
      <a class="btn btn--primary" href="/contact/">Propose a project</a>
    </div>
  </section>
  -->
</BaseLayout>
